# Postgres (Neon pooled URL for the app; use the direct URL when running `npm run db:migrate`)
DATABASE_URL=
# Long random string (>= 32 chars): `openssl rand -hex 32`
SESSION_SECRET=
# LINE Login channel (https://developers.line.biz/console/) — callback URL: https://<your-domain>/api/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Optional: only for previews before LINE is configured. NEVER enable on the production domain.
ALLOW_DEV_LOGIN=
NEXT_PUBLIC_SITE_URL=
